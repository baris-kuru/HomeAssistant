CaniPassword=changeme
FabiPassword=changeme
ICLOUD_USERNAME=your@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# FIREWORKS_API_KEY should be provided from your shell or macOS Keychain.
# Do not commit the real key into this repo.
FIREWORKS_API_KEY=
TELEGRAM_BOT_TOKEN=
# JWT secret for session tokens (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your-secret-key-here
ANTHROPIC_API_KEY=

# Home Assistant integration
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token-here

CHAT_MAX_CONCURRENT=3
CHAT_MAX_PER_USER=1
CHAT_MAX_DEEP=1
SEARCH_QUERY_FANOUT=3
SEARCH_RESULT_LIMIT=6
SEARCH_FETCH_CONCURRENCY=6
SEARCH_QUERY_TTL_S=300
SEARCH_PAGE_TTL_S=900
ROUTER_DEBUG=false